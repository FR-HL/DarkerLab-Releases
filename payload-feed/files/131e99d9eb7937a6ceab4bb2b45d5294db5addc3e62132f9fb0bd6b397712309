function I.add(p,name)
 I.capture(p)
 local d,row=I.generateData(name,2,-1)
 local bag=inventory(p,2)
 d=copyData(d)
 S.seq=S.seq+1;local id=2026102200000+S.seq
 save()
 d.ItemUniqueId=id;d.InventoryId=2;d.SlotId=-1;d.bEquipped=false
 assert(insert(p,d),'Original bag rejected item (space or class restrictions)')
 local found=false;local lib,get=api();bag.Values:ForEach(function(_,raw)local v=unwrap(raw);if v.ID._==id then
  assert(valid(v.DataAsset),'Original item data missing');local actual=copyData(get(lib,v))
  local actualName='';pcall(function()actualName=actual.ItemId.PrimaryAssetName:ToString()end)
  assert(actual.ItemUniqueId==id and actual.InventoryId==2,'Inserted bag record identity differs')
  assert(actualName==name,'Inserted bag record item ID differs: '..actualName..' / '..name)
  assert(#actual.ItemDataPrimaryPropertyArray==#d.ItemDataPrimaryPropertyArray,'Inserted bag primary properties differ')
  assert(#actual.ItemDataSecondaryPropertyArray==#d.ItemDataSecondaryPropertyArray,'Inserted bag secondary properties differ')
  found=true
 end end)
 assert(found,'Original insertion returned without matching inventory state')
 print(string.format('[NATIVE-ITEM] original rarity variant added id=%s rarity=%s primary=%d secondary=%d',name,tostring(row.rarity),#d.ItemDataPrimaryPropertyArray,#d.ItemDataSecondaryPropertyArray))
 return id
end
function I.infinite(p)
 if S.infiniteDisabled then return end
 local now=os.time();if S.infiniteNextAt and now<S.infiniteNextAt then return end;S.infiniteNextAt=now+3
 if S.infiniteBusy then return end
 S.infiniteBusy=true
 S.infiniteCounts=S.infiniteCounts or{}
 S.infiniteWhere=S.infiniteWhere or{}
 local ok,e=pcall(function()
  local lib,get=api()
  local seen={}
  for i=1,#p.InventoryComponentV2.InventoryList do
   local inv=unwrap(p.InventoryComponentV2.InventoryList[i])
   if valid(inv) and (inv.InventoryId==2 or inv.InventoryId==3) then
    inv.Values:ForEach(function(_,raw)
     local v=raw:get();local d=get(lib,v);local n=d.ItemId.PrimaryAssetName:ToString();seen[n]=true
     S.infiniteWhere[n]=d.InventoryId
     local c=tonumber(v.Stack) or tonumber(d.ItemCount) or 0
     local b=S.infiniteCounts[n]
     if not b or c>b then S.infiniteCounts[n]=c
     elseif c<b then
      local written,why=pcall(function() v.Stack=b end)
      if not written then print('[NATIVE-ITEM] stack write failed '..n..': '..tostring(why)) end
     end
    end)
   end
  end
  for n,_ in pairs(S.infiniteCounts) do
   if not seen[n] and S.templates[n] then
    local added,why=pcall(I.add,p,n)
    if not added then S.infiniteDisabled=true;S.infiniteStackables=false;print('[NATIVE-ITEM] automatic refill disabled after first failure '..n..': '..tostring(why));break end
   end
  end
 end)
 S.infiniteBusy=false
 if not ok then print('[NATIVE-ITEM] infinite audit failed: '..tostring(e)) end
end
return I

end
