  assert(type(entry)=='table'and type(entry.id)=='string'and entry.id:match('^Id_ItemPropertyType_[%w_]+$'),'Invalid original property type')
  local lo=assert(tonumber(entry.minimum),'Original property minimum missing');local hi=assert(tonumber(entry.maximum),'Original property maximum missing');assert(lo<=hi,'Invalid original property bounds')
  return{PropertyTypeId=api.makeAssetId('DesignDataItemPropertyType',entry.id),PropertyValue=api.randomInt(lo,hi),EnchantSourceItemId=api.makeAssetId('None','None')}
 end
 for _,entry in ipairs(assert(api.primaryEntries(row.primary_property_id),'Original primary property asset unavailable'))do data.ItemDataPrimaryPropertyArray[#data.ItemDataPrimaryPropertyArray+1]=property(entry)end
 local slots=tonumber(row.secondary_pool_count)or 0;assert(slots==#(row.secondary_pool_ids or{}),'PAK secondary slot count mismatch')
