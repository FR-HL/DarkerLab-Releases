end
-- UE4SS's nested table marshaller drops whole TArrays in this build.
-- Write each element into the real ItemData from the original add hook.
local ARRAY_FIELDS={'ItemDataPrimaryPropertyArray','ItemDataSecondaryPropertyArray','PermittedAreas'}
local function writeArray(target,field,source)
 local array=target[field]
 assert(array,'ItemData array missing: '..field)
 for i,v in ipairs(source)do
  if field=='PermittedAreas'then
   array[i]=v
  else
   array[i]={PropertyTypeId=v.PropertyTypeId,PropertyValue=v.PropertyValue,EnchantSourceItemId=v.EnchantSourceItemId}
  end
 end
end
applyProperties=function(target,source)
 target.Tradable=source.Tradable
 target.bEquipped=source.bEquipped
 for _,field in ipairs(ARRAY_FIELDS)do writeArray(target,field,source[field])end
end
insert=function(p,d)
 assert(not S.pendingInsert,'Nested training insertion')
 if not S.arrayHook then
  S.arrayHook={RegisterHook('/Script/DungeonCrawler.DCInventoryComponent:AddItemDataToInventory',function(context,inv,param)
   local pending=S.pendingInsert;if not pending then return end
   if context:get():GetAddress()~=pending.owner then return end
   local target=param:get();if target.ItemUniqueId~=pending.data.ItemUniqueId then return end
   local ok,e=pcall(applyProperties,target,pending.data);pending.repaired=ok;pending.error=e
  end)}
 end
 local request={owner=p.InventoryComponentV2:GetAddress(),data=d};S.pendingInsert=request
 local outgoing=copyData(d);for _,n in ipairs(ARRAY_FIELDS)do outgoing[n]={}end
 local ok,accepted=pcall(function()return p.InventoryComponentV2:AddItemDataToInventory(d.InventoryId,outgoing)end)
 S.pendingInsert=nil
 assert(ok and accepted and request.repaired,'Original insertion failed: '..tostring(request.error or accepted))
 return accepted
end
local function matches(p,records)
 local actual={};local count=0;local lib,get=api()
 for i=1,#p.InventoryComponentV2.InventoryList do local inv=unwrap(p.InventoryComponentV2.InventoryList[i])
  inv.Values:ForEach(function(_,raw)local d=copyData(get(lib,unwrap(raw)));actual[d.ItemUniqueId]=d;count=count+1 end)
 end
 if count~=#records then return false end
 for _,d in ipairs(records)do if not sameValue(actual[d.ItemUniqueId],d)then return false end end
 return true
end
function I.matches(p,records)return matches(p,records)end
function I.restore(p,records)
 assert(valid(p)and p.AbilitySystemComponent.bGASInitilized and not p.bIsDead,'Player not ready for original inventory restore')
 local bag=inventory(p,2)
 local existing={}
 bag.Values:ForEach(function(_,raw)local v=unwrap(raw);existing[v.ItemUniqueId]=true end)
 local added=0
 for _,record in ipairs(records)do
  if not existing[record.ItemUniqueId]then
   local d=copyData(record)
   S.seq=S.seq+1;d.ItemUniqueId=2026102200000+S.seq
   d.InventoryId=2;d.SlotId=-1;d.bEquipped=false
   assert(insert(p,d),'Original bag rejected restored item: '..record.ItemId.PrimaryAssetName:ToString())
   added=added+1
  end
 end
 if added>0 then save()end
 return added>0
end
function I.equipSlot(p,name,slot)
 I.capture(p)
 local d,row=I.generateData(name,3,slot)
 local actualSlot=slot
 local byType={['Type.Item.Slot.Primary']=10,['Type.Item.Slot.Secondary']=11,['Type.Item.Slot.Head']=1,['Type.Item.Slot.Chest']=2,['Type.Item.Slot.Hands']=3,['Type.Item.Slot.Legs']=4,['Type.Item.Slot.Foot']=5,['Type.Item.Slot.Necklace']=6,['Type.Item.Slot.Back']=8,['Type.Item.Slot.Sash']=9,['Type.Item.Slot.Ring']=12}
 if row and row.slot_type and byType[row.slot_type] then actualSlot=byType[row.slot_type] end
 if row and row.slot_type and S.slotByType and S.slotByType[row.slot_type] then actualSlot=S.slotByType[row.slot_type] end
 d=copyData(d);S.seq=S.seq+1;local id=2026102200000+S.seq
 d.ItemUniqueId=id;d.InventoryId=3;d.SlotId=actualSlot;d.bEquipped=true
 local inserted=pcall(insert,p,d)
 if not inserted then
  local drop={[actualSlot]=true}
  rebuildFor(p,drop,{d})
  save();refreshEquipment(p);I.capture(p);writeEquipmentView(p)
  print(string.format('[NATIVE-ITEM] rebuilt equipped item id=%s slot=%d',name,actualSlot))
  return id,actualSlot
 end
 I.capture(p);writeEquipmentView(p)
 print(string.format('[NATIVE-ITEM] equipped original item id=%s slot=%d',name,actualSlot))
 return id,actualSlot
end
