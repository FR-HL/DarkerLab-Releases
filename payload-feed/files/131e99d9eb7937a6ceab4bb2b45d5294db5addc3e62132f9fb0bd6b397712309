  local pool=assert(pools[poolId],'Original PAK property pool missing: '..poolId);local candidates={}
  for _,entry in ipairs(pool.entries or{})do
   local typeId=tostring(entry.property_type_reference or''):match('(Id_ItemPropertyType_[%w_]+)')
   if typeId then candidates[#candidates+1]={id=typeId,minimum=entry.property.minimum_raw,maximum=entry.property.maximum_raw}end
  end
  local available={};for _,candidate in ipairs(candidates)do if not selected[candidate.id]then available[#available+1]=candidate end end
  assert(#available>0,'No unused original affix candidates in pool '..poolId)
  local chosen=available[api.randomInt(1,#available)];selected[chosen.id]=true
  data.ItemDataSecondaryPropertyArray[#data.ItemDataSecondaryPropertyArray+1]=property(chosen)
 end
