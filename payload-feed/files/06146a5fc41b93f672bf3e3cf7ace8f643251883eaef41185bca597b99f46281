"use strict";

// Wire framing and diagnostic decoding. Gameplay/lobby state stays out of here.

function frame(cmd, body, flag = 0) {
  const len = 8 + body.length;
  const h = Buffer.alloc(8);
  h.writeUInt32LE(len, 0);
  h.writeUInt16LE(cmd, 4);
  h.writeUInt16LE(flag, 6);
  return Buffer.concat([h, body]);
}

function decodeTopLevel(buf) {
  const parts = [];
  let i = 0;
  while (i < buf.length) {
    let key = 0;
    let shift = 0;
    let b;
    do {
      b = buf[i++];
      key |= (b & 0x7f) << shift;
      shift += 7;
    } while (b & 0x80 && i < buf.length);
    const num = key >>> 3;
    const wire = key & 7;
    if (wire === 0) {
      let v = 0;
      let s = 0;
      do {
        b = buf[i++];
        v |= (b & 0x7f) << s;
        s += 7;
      } while (b & 0x80 && i < buf.length);
      parts.push(`f${num}=${v}`);
    } else if (wire === 1) {
      parts.push(`f${num}:f64`);
      i += 8;
    } else if (wire === 2) {
      let l = 0;
      let s = 0;
      do {
        b = buf[i++];
        l |= (b & 0x7f) << s;
        s += 7;
      } while (b & 0x80 && i < buf.length);
      const sub = buf.subarray(i, i + l);
      i += l;
      const printable = l > 3 && [...sub].every((c) => c === 0 || (c >= 0x20 && c < 0x7f));
      parts.push(`f${num}=${printable ? '"' + sub.toString("utf8").slice(0, 60) + '"' : sub.toString("hex").slice(0, 60)}`);
    } else if (wire === 5) {
      parts.push(`f${num}:f32`);
      i += 4;
    } else {
      parts.push(`w${wire}!`);
      break;
    }
  }
  return parts.join(" | ");
}

function bufF64(buf, fieldNum) {
  for (let i = 0; i + 9 <= buf.length; i++) {
    const key = buf[i];
    if ((key >>> 3) === fieldNum && (key & 7) === 1) return buf.readBigUInt64LE(i + 1);
  }
  return 1n;
}

module.exports = { frame, decodeTopLevel, bufF64 };
