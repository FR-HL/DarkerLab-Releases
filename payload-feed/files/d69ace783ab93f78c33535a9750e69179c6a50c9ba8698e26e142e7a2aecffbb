 local function currentOf(all)for _,o in ipairs(all)do if sameWorld(o)then return o end end end
 local volume=assert(currentOf(volumes),'Navigation bounds for the current world unavailable');local system=assert(currentOf(systems),'Navigation system for the current world unavailable')
