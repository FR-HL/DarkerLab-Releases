 local scale={X=oldScale.X*math.max(1,10000/math.max(extent.X,1)),Y=oldScale.Y*math.max(1,10000/math.max(extent.Y,1)),Z=oldScale.Z*math.max(1,5000/math.max(extent.Z,1))}
