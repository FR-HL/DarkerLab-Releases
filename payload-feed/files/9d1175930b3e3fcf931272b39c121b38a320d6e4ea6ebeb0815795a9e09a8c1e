local function resolveGameRoot()
  local explicit=os.getenv('DARKERLAB_GAME_PATH')
  if explicit and explicit~='' then return (explicit:gsub('\\','/'):gsub('/+$','')) end
  return ROOT..'/game/'..(os.getenv('DARKERLAB_GAME_COPY') or 'Dark and Darker-NoAC')
end
