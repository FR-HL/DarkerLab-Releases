local function loadMapPath(path)
  _G.__LAST_MAP = string.match(path, "([^/]+)$")
  ExecuteInGameThread(function()
    pcall(function()
      local pc = FindFirstOf("PlayerController")
      if pc ~= nil then
        local extra = ""; if _G.__LISTEN then extra = "?listen" end
        if _G.__LISTEN then
          local gs2 = StaticFindObject("/Script/Engine.GameplayStatics")
          local ok2, w2 = pcall(function() local pc2 = FindFirstOf("PlayerController") return pc2 and pc2.Pawn and pc2.Pawn:GetWorld() end)
          local okw2, ww2 = pcall(function() return FindFirstOf("World") end)
          local ctx = (ok2 and w2) or (okw2 and ww2) or pc
          P("openlevel listen ctx=" .. tostring(ctx))
          pcall(function() gs2:OpenLevel(ctx, path .. "?Name=Player?AccountId=1" .. GM .. extra, true, "Name=Player?AccountId=1") end)
        else
          pc:SwitchLevel(path .. "?Name=Player?AccountId=1" .. GM .. extra)
        end
        P("loadMap " .. path)
      end
    end)
  end)
end

local function loadRoom(idx)
  local r = ROOMS[idx]
  if r == nil then P("no room " .. tostring(idx)); return end
  loadMapPath(r[2])
end

