end
function M.adopt(o)
 assert(T.isA(o,'DCMonsterBase'),'Original monster required')
 assert(_G.__AI_PAUSED==true,'Custom AI must remain disabled')
 local pc=require('UEHelpers').GetPlayerController()
 local actorWorld=T.world(o);local currentWorld=T.world(pc)
 assert(T.valid(pc)and T.valid(actorWorld)and T.valid(currentWorld)and actorWorld:GetAddress()==currentWorld:GetAddress(),'Actor outside active offline world')
