function M.tick()M.core.tick()end
M.timer=Q.loop(250,function()local ok,e=pcall(M.tick);if not ok then log('SERVICE','PARTIAL',e)end;return false end)
-- A spawn event only requests discovery; no Unreal calls are made in the hook.
local ok,a,b=pcall(RegisterHook,'/Script/DungeonCrawler.DCGameSpawner:SpawnMonster',function()M.dirty=true end,function()M.dirty=true end)
