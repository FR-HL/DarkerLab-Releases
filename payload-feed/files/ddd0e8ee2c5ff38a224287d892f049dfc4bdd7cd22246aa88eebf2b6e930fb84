end
M.core=Core.new(env)
if existing and existing.core then
 for _,id in ipairs(existing.core.order)do local prior=existing.core.records[id]
  if prior.phase~='removed'and T.valid(prior.actor)then
   local record=M.core.adopt(prior.actor,prior.root);record.phase=prior.phase;record.reason=prior.reason;record.created=prior.created
