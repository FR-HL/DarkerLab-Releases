local function ensureGameInfoFallback(world)
  if not valid(world)or not world:GetFullName():find('/Arena/',1,true)then return false end
  local ok,result=pcall(function()
    local gs=world.GameState;assert(valid(gs),'Current arena GameState missing')
    local address=gs:GetAddress()
    if S.gameInfoFallbackInstalled and S.gameInfoFallbackState==address then return true end
    if S.gameInfoFallbackRetryAt and os.time()<S.gameInfoFallbackRetryAt then return false end
    S.gameInfoFallbackRetryAt=os.time()+3
    local dll=OUT..'training_core.dll'
    local install,loadError=package.loadlib(dll,'native_training_gameinfo_fallback_install_direct');assert(install,loadError)
    assert(install(address)==1,'GameInfo fallback rejected this GameState')
    S.gameInfoFallbackInstalled=true;S.gameInfoFallbackState=address;S.gameInfoFallbackRetryAt=nil
    log('null-only GameInfo fallback installed state='..string.format('%x',address))
    return true
  end)
  if not ok then S.gameInfoFallbackInstalled=false;S.gameInfoFallbackState=nil;log('GameInfo fallback pending: '..tostring(result))end
  return ok and result==true
end
