  end
  local item=raw:match('^item (Id_Item_[%w_]+)$')
  if item then local _,p=player();assert(p,'No dungeon player');local id=Inventory.add(p,item);S.loadoutCount=Inventory.saveLoadout(p);S.presetPawn=p:GetAddress();S.action='Added to original bag: '..item..' ('..id..')';return end
  if raw=='lobby' then
    local pc=require('UEHelpers').GetPlayerController()
    assert(valid(pc),'No PlayerController for lobby travel')
    local ok,result=pcall(function()return pc:SwitchLevel('/Game/DungeonCrawler/Maps/Lobby_P?Name=Player?AccountId=1')end)
    assert(ok,'Lobby SwitchLevel failed: '..tostring(result))
    S.action='Returning to lobby';return
  end
  local room=tonumber(raw:match('^room (%d+)$'))
  if room then
    assert(room>=1 and room<=14,'Invalid room')
    S.room=room
    S.activeMonster=nil;S.restartMonster=nil;S.replayPending=nil;S.victoryAt=nil;S.observedMonster=nil
    Switch.clear();Runtime.clear(S.monsters)
    S.spawnStage=nil;S.monsters={};S.travelUntil=os.time()+8
    reloadRoom(room)
    S.action='Loading original room '..room;return
  end
  if raw=='clear' then Switch.clear();return end
  local mode,key=raw:match('^switch%-scene (current) (.+)$')
  if not mode then mode,key=raw:match('^switch%-scene (original) (.+)$')end
  if mode then S.roomReady=false;Switch.select(key,{mode=mode});S.sceneMode=mode;return end
  key=raw:match('^spawn (.+)$')or raw:match('^switch (.+)$')
  if key then Switch.select(key,{mode=S.sceneMode});return end
  error('Unsupported panel command: '..raw)
end
local function execute(raw)
  local receipt=UI.beginCommand(S,raw);local ok,e=pcall(command,raw)
  if ok then S.actionUntil=os.time()+6 end
  UI.finishCommand(S,Switch,receipt,ok,e)
  if not ok then S.action=tostring(e);log(S.action)end
  return ok,e
end
local function unwrap(value)
  local ok,inner=pcall(function() return value:get() end)
  if ok and inner~=nil then return inner end
  return value
end
local function assetName(id)
  if id==nil then return '' end
  local ok,name=pcall(function() return id.PrimaryAssetName:ToString() end)
  if ok and name and name~='None' then return name end
  return ''
end
local function nativeAbilitySnapshot(p)
  local out={}
  pcall(function()
    local values={};local arr=p.PerkDataComponent.PerkDataIds
    for i=1,#arr do values[i]=assetName(arr[i]) end
    out.perk=values
  end)
  pcall(function()
    local values={};for i=1,2 do values[i]='' end
    local arr=p.SkillComponent.SkillActors
    for i=1,#arr do
      local actor=unwrap(arr[i])
      if valid(actor) then
        local slot=tonumber(actor.SkillData.SlotIndex)
        local id=assetName(actor.SkillData.SkillId)
        if slot and id~='' then values[slot+1]=id end
      end
    end
    out.skill=values
  end)
  pcall(function()
    local values={};for i=1,10 do values[i]='' end
    local arr=p.SpellComponent.SpellActors
    for i=1,#arr do
      local actor=unwrap(arr[i])
      if valid(actor) then
        local slot=tonumber(actor.SpellData.SlotIndex)
        local id=assetName(actor.SpellData.SpellId)
        if slot and slot>=0 and slot<10 and id~='' then values[slot+1]=id end
      end
    end
    out.spell=values
  end)
  pcall(function()
    local values={};for i=1,10 do values[i]='' end
    local arr=p.MusicComponent.MusicActors
    for i=1,#arr do
      local actor=unwrap(arr[i])
      if valid(actor) then
        local slot=tonumber(actor.MusicData.SlotIndex)
        local id=assetName(actor.MusicData.MusicId)
        if slot and slot>=0 and slot<10 and id~='' then values[slot+1]=id end
      end
    end
    out.music=values
  end)
  return out
end
local function sameSlots(actual,expected)
  if not actual then return false end
  for i=1,#expected do if (actual[i]or'')~=(expected[i]or'') then return false end end
  return true
end

local function tick()
  Mailbox.poll()
  pcall(applySpeed)
  local queued=Mailbox.take(S.lastCommandId)
  if queued then
    S.lastCommandId=queued.id
    Mailbox.ack(queued.id,true,'started')
    local ok,e=pcall(execute,queued.text)
    pcall(Mailbox.ack,queued.id,ok,e)
  end
  if S.travelUntil and os.time()<S.travelUntil then S.hasPlayer=false;S.sample='Waiting for original room load';return end
  local pc,p=player()
  S.hasPlayer=p~=nil
  if not p then S.sample='Waiting for dungeon player';S.uiHp=0;S.uiMaxHp=0;return end
  if S.classSwitchPending and p.AbilitySystemComponent.bGASInitilized then
    local actual=tonumber(p.CharacterKey.CharacterClass)
    S.uiActualClass=actual
    if actual==S.classSwitchPending.choice then
      S.action='Selected original '..Classes.names[actual]..' is active'
      S.classSwitchPending=nil;S.uiError=nil;log(S.action)
      S.abilityEquipped=nil
      local classId='Id_PlayerCharacter_'..(Classes.names[actual]or'')
      pcall(function()local text=Abilities.write(classId);publishModel('panel-abilities.tsv',text);publishModel('panel-ability-slots.tsv',writeAbilitySlots(classId))end)
    elseif os.time()-S.classSwitchPending.started>=12 then
      local wanted=S.classSwitchPending.choice
      local wantedName=Classes.names[wanted]or tostring(wanted)
      local actualName=Classes.names[actual]or tostring(actual)
      S.uiError='职业切换未生效：所选 '..wantedName..'，游戏角色仍是 '..actualName
      S.action=S.uiError;S.classSwitchPending=nil;S.classMismatch=true;log(S.uiError)
      S.uiResult={id=(S.uiSequence or 0)+1,kind='class',status='error',title='职业切换失败',detail=S.uiError,error=S.uiError}
      S.uiSequence=(S.uiSequence or 0)+1
    end
  elseif p.AbilitySystemComponent.bGASInitilized then
    local actual=tonumber(p.CharacterKey.CharacterClass)
    if S.uiActualClass~=actual then
      S.uiActualClass=actual;S.classMismatch=nil;S.abilityEquipped=nil
      local classId='Id_PlayerCharacter_'..(Classes.names[actual]or'')
      pcall(function()local text=Abilities.write(classId);publishModel('panel-abilities.tsv',text);publishModel('panel-ability-slots.tsv',writeAbilitySlots(classId))end)
    end
  end
  if p.AbilitySystemComponent.bGASInitilized then
   if (S.abilityRecoveryAutoTick or 0)<=0 then
    local blocked=false
    if S.autoRecover then blocked=true
    elseif attackBlocked then
     local ok,value=pcall(attackBlocked);blocked=ok and value==true
    end
    if blocked then
     S.abilityRecoveryAutoTick=1
     pcall(recoverAttack,true)
    else
     S.abilityRecoveryAutoTick=4
    end
   else
    S.abilityRecoveryAutoTick=(S.abilityRecoveryAutoTick or 0)-1
   end
  end
  ensureGameInfoFallback(pc:GetWorld())
  local okShape,shapeStatus=pcall(NativeShapeMemory.tick,p)
  if not okShape then log('native shape memory: '..tostring(shapeStatus)) end
  pcall(shiftAudit,p)
  local name=p:GetFullName();local address=p:GetAddress();local hp,max,a=health(p)
  if S.pawnAddress~=address then
    Positions.captureEntry(p,Positions.snapshot(p).world..'|world-entry','observed-world-entry')
    -- Old UE handles belong to the old pawn. Never remove unrelated native effects.
    local previous=S.pawnAddress;S.pawnAddress=address
    if S.guardState and S.guardState.address~=address then S.guardState=nil end
    log('local pawn='..name)
    S.inventoryCaptured=nil;S.presetPawn=nil;S.loadoutCount=0
    S.attributeValues=nil
    if S.attributeTarget then S.attributeTarget.applied=nil end
    if previous and S.repeatTraining then
      S.victoryAt=nil;S.observedMonster=nil
      Runtime.clear(S.monsters);S.monsters={};S.spawnStage=nil
      S.restartMonster=S.activeMonster;S.replayPending=true
      S.restoreProgress=nil
    end
  end
  local attributeClass=tonumber(p.CharacterKey.CharacterClass)

  if p.AbilitySystemComponent.bGASInitilized and S.attributeTarget and S.attributeTarget.class==attributeClass then
    local okNow,nowVals=pcall(Attributes.read,p)
    local match=false
    if okNow then
      match=true
      for i=1,7 do if math.abs(nowVals[i]-S.attributeTarget.values[i])>0.01 then match=false;break end end
    end
    if not match then
      local okApply,errApply=pcall(Attributes.writePlayer,p,S.attributeTarget.values)
      if okApply then
        local okV,vals=pcall(Attributes.read,p)
        if okV then S.attributeValues=vals;log('ATTR-ENFORCE '..table.concat(vals,',')) end
      else log('ATTR-ENFORCE-FAIL '..tostring(errApply)) end
    else
      S.attributeValues=S.attributePreviewValues or nowVals
    end
  end
  if p.AbilitySystemComponent.bGASInitilized and attributeClass then
    local ok,values=pcall(Attributes.read,p)
    if ok then S.attributeValues=S.attributePreviewValues or values end
    local pending=S.attributePending
    if pending and pending.class==attributeClass and ok then
      local matched=true
      for i=1,7 do if math.abs(values[i]-pending.target[i])>0.01 then matched=false;break end end
      if matched then
        S.attributePending=nil;S.uiError=nil
        S.uiSequence=(S.uiSequence or 0)+1
        if pending.reset then
          S.action='基础属性已恢复当前职业默认（本轮已重载）'
          S.uiResult={id=S.uiSequence,kind='attributes',status='ok',title='基础属性已恢复默认',detail='本轮角色已按原版默认七项基础值初始化。'}
        else
          S.action='基础属性已应用（本轮已重载）'
          S.uiResult={id=S.uiSequence,kind='attributes',status='ok',title='基础属性已应用',detail='本轮角色已按新的七项基础值初始化。'}
        end
        log(S.action)
      elseif os.time()-pending.started>=20 then
        local detail='重载后读取到的七项基础值未达到目标；职业效果资产可能未被本轮初始化使用。'
        S.attributePending=nil;S.uiError=detail;S.action=detail
        S.uiSequence=(S.uiSequence or 0)+1
        S.uiResult={id=S.uiSequence,kind='attributes',status='error',title='基础属性未生效',detail=detail,error=detail}
        log(detail)
      end
    end
  end


  if p.AbilitySystemComponent.bGASInitilized and attributeClass and S.abilityPending and S.abilityPending.class==attributeClass then
    local pending=S.abilityPending
    local snapshot=nativeAbilitySnapshot(p)
    if sameSlots(snapshot[pending.category],pending.expected) then
      S.abilityPending=nil;S.uiError=nil
      S.uiSequence=(S.uiSequence or 0)+1
      S.action=ABILITY_NAMES[pending.category]..' 已由原版初始化生成（本轮已重载）'
      S.uiResult={id=S.uiSequence,kind='ability',status='ok',title='能力已由原版初始化生成',detail=ABILITY_NAMES[pending.category]..' 槽位与原版职业行一致。'}
      log(S.action)
    elseif os.time()-pending.started>=20 then
      local detail='重载后原版未生成预期的'..ABILITY_NAMES[pending.category]..'槽位；本轮没有做任何手动授予。'
      S.abilityPending=nil;S.uiError=detail;S.action=detail
      S.uiSequence=(S.uiSequence or 0)+1
      S.uiResult={id=S.uiSequence,kind='ability',status='error',title='原版初始化未生效',detail=detail,error=detail}
      log(detail)
    end
  end
  if not S.inventoryCaptured and p.AbilitySystemComponent.bGASInitilized and hp and hp>0 then
    local names=Inventory.capture(p);S.inventoryCaptured=true
    publishModel('panel-items.tsv',(UI.writeItems(names)))
    if not Switch.phase or Switch.phase=='idle'or Switch.phase=='adopted'then
      S.action='Original '..Classes.names[p.CharacterKey.CharacterClass]..' ready; '..#p.EquipmentComponentV2:GetEquippedItemInfos()..' equipped items'
    end
    local saved=Inventory.loadLoadout(p)
    if saved then S.loadoutCount=#saved;if S.repeatTraining then S.replayPending=true end end
    if loadoutSmoke and not S.loadoutSmokeDone then
      S.loadoutSmokeDone=true
      local ok,detail=pcall(function()
        local count,class=Inventory.savePreset(p,'__smoke__')
        local records=Inventory.loadPreset(p,'__smoke__')
        return 'save='..tostring(count)..' class='..tostring(class)..' loaded='..tostring(records and #records)
      end)
      log('loadout-smoke '..(ok and detail or tostring(detail)))
    end
    if not S.characterResetBaseline or S.characterResetBaseline.address~=address then
      local lib=StaticFindObject('/Script/GameplayAbilities.Default__AbilitySystemBlueprintLibrary')
      local getEffect=StaticFindObject('/Script/GameplayAbilities.AbilitySystemBlueprintLibrary:GetGameplayEffectFromActiveEffectHandle')
      local getGranted=StaticFindObject('/Script/GameplayAbilities.AbilitySystemBlueprintLibrary:GetGameplayEffectGrantedTags')
      S.characterResetBaseline=CharacterReset.capture(p,{effect=function(h)return getEffect(lib,h)end,name=function(o)return o and o:GetFullName()or''end,transient=function(effect,n)
       if n:find('/Perk/',1,true)then return false end
       if n:find('/Skill/',1,true)or n:find('/Spell/',1,true)then return true end
       local ok,tags=pcall(function()return getGranted(lib,effect:GetClass())end)
       return ok and CharacterReset.isTransientTags(tags.GameplayTags)
      end})
      log('Character reset baseline captured effects='..tostring((function()local n=0;for _ in pairs(S.characterResetBaseline.handles)do n=n+1 end;return n end)()))
    end
  end
  if S.guard and p.AbilitySystemComponent.bGASInitilized then S.guardState=Guard.enable(p,S.guardState)end
  if S.replayPending and p.AbilitySystemComponent.bGASInitilized and hp and hp>0 and not p.bIsDead then
    -- Restore only this original class's complete, build-pinned record set.
    -- The same pawn retains its bag on reset; a new pawn restores once.
    if S.presetPawn~=address then
      local records=Inventory.loadLoadout(p)
      if records then
        local ok,e=pcall(Inventory.restore,p,records)
        if not ok then S.action='Loadout restore failed: '..tostring(e);S.replayPending=nil;log(S.action);return end
        S.loadoutCount=#records;log('Saved loadout items added to bag pawn='..name..' records='..#records)
      end
      S.presetPawn=address
    end
    local key=S.restartMonster
    if key then command('spawn '..key)else S.action='Original player restored; training choices retained'end
    S.replayPending=nil;S.restartMonster=nil
  end
  hp,max=health(p)
  S.sample=string.format('HP %.1f / %.1f | original immune=%s',tonumber(hp)or -1,tonumber(max)or -1,tostring(Guard.has(p)))
  S.uiHp=hp;S.uiMaxHp=max
  if S.infiniteStackables and S.inventoryCaptured then pcall(Inventory.infinite,p) end
  local positionReady,canPosition=pcall(Switch.canResetPositions,p);S.uiCanResetPosition=positionReady and canPosition
  -- Observe original death only. Training orchestration never writes monster HP.
  local m=_G.__NATIVE_TRAINING_MONSTER
  S.uiMonsterHp=nil;S.uiMonsterMaxHp=nil
  if not S.spawnStage and valid(m) and m.AbilitySystemComponent.bGASInitilized then
    local mh,mm=health(m)
    if mh and mm and mm>0 then
      S.uiMonsterHp=mh;S.uiMonsterMaxHp=mm
      if mh>0 then S.observedMonster=m:GetAddress()
      elseif S.repeatTraining and S.observedMonster==m:GetAddress() and not S.victoryAt and not S.deathFailure then
        S.victoryAt=os.time()+5;S.action='Original monster defeated; next round in 5 seconds';log(S.action)
      end
    end
  end
  if S.victoryAt and not S.repeatTraining then S.victoryAt=nil end
  if S.victoryAt and os.time()>=S.victoryAt and hp and hp>0 and not p.bIsDead and not S.deathFailure then command('reset')end
end
