    if not ok or type(values)~='table'then values=S.attributeValues end
    S.attributePreviewClass=preview
    S.attributePreviewValues=values
    S.attributeValues=values
    S.abilityPreviewClass=preview
    local previewClassId='Id_PlayerCharacter_'..className
    local actualClass
    local _,p=player()
    if p then actualClass=tonumber(p.CharacterKey and p.CharacterKey.CharacterClass) end
    pcall(function()
      local text=Abilities.write(previewClassId)
      publishModel('panel-abilities.tsv',text)
      publishModel('panel-ability-slots.tsv',writeAbilitySlots(previewClassId,preview~=actualClass))
    end)
    S.action='预览职业：'..className
    log(S.action)
    return
  end
  local career,careerValues=raw:match('^career apply (%d+)%s+(.+)$')
  if career then
    local choice=tonumber(career)
    local className=Classes.names[choice];assert(className,'Unknown original class')
    local values={}
    for value in careerValues:gmatch('%d+')do values[#values+1]=tonumber(value)end
    Attributes.validate(values)
    Classes.select(choice)
    Attributes.writeEffect('Id_PlayerCharacterEffect_'..className,values)
    S.attributeDefaultsByClass[choice]=values
    S.attributeTarget={class=choice,name='Id_PlayerCharacterEffect_'..className,values=values,applied=nil}
    S.attributePreviewClass=nil
    S.attributePreviewValues=nil
    S.abilityPreviewClass=nil
    S.abilityEquipped=nil
    S.attributeValues=values
