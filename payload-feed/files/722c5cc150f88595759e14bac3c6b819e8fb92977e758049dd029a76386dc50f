local function writeAbilitySlots(classId,useDefaults)
  local defaults=Abilities.defaults(classId)
  local equipped=useDefaults and defaults or S.abilityEquipped
  if equipped==nil then equipped=defaults end
  local out={}
  for _,cat in ipairs({'skill','spell','perk','shift','music'})do
    local values=equipped[cat]or defaults[cat]or{}
    for slot=1,5 do
      if values[slot]and values[slot]~=''then
        out[#out+1]=cat..'\t'..slot..'\t'..values[slot]
      end
    end
  end
  return table.concat(out,'\n')..'\n'
