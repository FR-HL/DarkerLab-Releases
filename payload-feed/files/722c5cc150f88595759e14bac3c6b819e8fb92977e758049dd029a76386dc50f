  end
  local choice=tonumber(raw:match('^class (%d+)$'))
  if choice then
    Classes.select(choice);S.loadoutCount=0;S.presetPawn=nil;S.uiActualClass=nil;S.uiError=nil
    S.attributeTarget=nil;S.attributePending=nil;S.attributeValues=nil
    S.attributePreviewClass=nil;S.attributePreviewValues=nil;S.abilityPreviewClass=nil
    S.classSwitchPending={choice=choice,started=os.time()}
    S.action='正在应用训练职业：'..(Classes.names[choice]or tostring(choice))
