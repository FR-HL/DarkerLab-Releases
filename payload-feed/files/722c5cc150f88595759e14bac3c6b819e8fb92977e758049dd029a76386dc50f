    S.uiResult={id=S.uiSequence,kind='attributes',status='ok',title=reset and'基础属性已恢复默认'or'基础属性已应用',detail=reset and'角色当前七项基础值已恢复默认。'or'角色当前七项基础值已直接写入。'}
    S.action=reset and'基础属性已恢复默认' or'基础属性已应用';log(S.action);return
  end
  local preview=tonumber(raw:match('^class%-preview (%d+)$'))
