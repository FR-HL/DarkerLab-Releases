local function shiftAudit(p)
  local seen=S.shiftAuditSeen or{};S.shiftAuditSeen=seen
  local asc=p and p.AbilitySystemComponent
  if valid(asc)then
    local items=asc.ActivatableAbilities and asc.ActivatableAbilities.Items
    local n=0;pcall(function()n=#items end)
    for i=1,math.min(n,128)do
      local raw=items[i];local spec=raw
      pcall(function()if raw.get then spec=raw:get()end end)
      local ability=spec and spec.Ability;local aname=valid(ability)and ability:GetFullName()or''
      if aname:find('ShapeShift',1,true)then
        local active=tonumber(spec.ActiveCount)or 0
        local k='s|'..aname..'|'..active..'|'..tostring(spec.InputPressed)
        if not seen[k]then seen[k]=true;log('AUDIT spec '..aname..' active='..active..' input='..tostring(spec.InputPressed))end
        for _,arrName in ipairs({'NonReplicatedInstances','ReplicatedInstances'})do
          local arr=spec[arrName];local m=0;pcall(function()m=#arr end)
          for j=1,math.min(m,4)do
            local inst=arr[j];pcall(function()if inst.get then inst=inst:get()end end)
            local dat=inst.CurrentShapeShiftDataAsset;local mont=inst.CurrentMontage
            local st=(valid(dat)and dat:GetFullName()or'nil')..'|'..(valid(mont)and mont:GetFullName()or'nil')..'|'..tostring(inst.bIsAbilityEnding)
            local ik='i|'..aname..'|'..j..'|'..st
            if not seen[ik]then seen[ik]=true;log('AUDIT inst '..aname..' data='..st)end
          end
        end
      end
    end
  end
  local c=p and p.ShapeShiftComponent
  if valid(c)then
    local cur=valid(c.Data)and c.Data:GetFullName()or'nil'
    local ah=c.AbilitySpecHandles;local an=0;pcall(function()an=#ah end)
    local eh=c.GameplayEffectHandles;local en=0;pcall(function()en=#eh end)
    local k='c|'..cur..'|'..an..'|'..en
    if not seen[k]then seen[k]=true;log('AUDIT comp data='..cur..' handles='..an..' effects='..en)end
  end
  local sc=p and p.SkillComponent
  if valid(sc)then
    local sd=sc.ShapeShiftSkillDatas;local dn=0;pcall(function()dn=#sd end)
    local k='d|'..dn
    if not seen[k]then seen[k]=true;log('AUDIT skill.datas='..dn)end
  end
  local cc=p and p.ClassShapeShiftComponent
  if valid(cc)then
    local sd=cc.ShapeShiftDatas;local dn=0;pcall(function()dn=#sd end)
    local k='k|'..dn
    if not seen[k]then seen[k]=true;log('AUDIT class.datas='..dn)end
  end
end

-- Native loadout apply. The class row is the only writable source: the
-- original initializer builds perks/skills/spells/musics from it. No ability
-- is granted here and no runtime component is written.
local function mergedMemory(cat,group,slots)
  local out={}
  for i=1,10 do out[i]='' end
  local first=S.abilityEquipped and S.abilityEquipped[cat..'#1']or{}
  local second=S.abilityEquipped and S.abilityEquipped[cat..'#2']or{}
  if group==1 then first=slots elseif group==2 then second=slots end
  for i=1,5 do out[i]=first[i]or'';out[i+5]=second[i]or'' end
  return out
end
local function abilityApply(acat,payload,group)
  local _,p=player();assert(p,'No dungeon player')
  local limit=ABILITY_LIMITS[acat];assert(limit,'ability apply: unknown category')
  local text=tostring(payload or'');local slots={};local seen={};local count=0;local start=1
  while true do
    local stop=text:find('|',start,true)
    local id=text:sub(start,stop and stop-1 or #text)
    slots[#slots+1]=id
    if id~=''then
      assert(not seen[id],'同一能力不能放在两个槽位：'..id)
      seen[id]=true;count=count+1
    end
    if not stop then break end
    start=stop+1
  end
  assert(count<=limit,ABILITY_NAMES[acat]..'最多 '..limit..' 个（当前 '..count..'）')
  local choice=Classes.selected()
  if acat=='shift'then
    S.action='变形形态由原版职业行生成：本页不再写入轮盘、技能或形态数据'
    log(S.action)
    return
  end
  if (acat=='spell'or acat=='music')and group==nil then group=1 end
  if acat=='spell'then
    assert(NativeLoadout.spellBankEnabled(choice),'先应用技能页的法术记忆（SpellMemory/Sorcery），原版才会生成法术槽')
  elseif acat=='music'then
    assert(NativeLoadout.musicBankEnabled(choice),'先应用技能页的音乐记忆（MusicMemory），原版才会生成音乐槽')
  end
  S.abilityEquipped=S.abilityEquipped or{}
  S.abilityEquipped[acat..(group and('#'..tostring(group))or'')]=slots
  local nativeSlots
  if acat=='spell'or acat=='music'then nativeSlots=mergedMemory(acat,group,slots)
  else nativeSlots={};for _,id in ipairs(slots)do if id~=''then nativeSlots[#nativeSlots+1]=id end end end
  NativeLoadout.setCategory(choice,acat,nativeSlots)
  local report=NativeLoadout.apply(choice)
  assert(report and report.applied,'本 build 无法写入原版职业行；不会回退手动授予（UE4SS 数组赋值实测会崩溃）')
  S.abilityPending={class=choice,category=acat,group=group,expected=nativeSlots,started=os.time()}
  S.abilityPreviewClass=nil
  publishModel('panel-ability-slots.tsv',writeAbilitySlots(classIdOf(p)))
  S.action='已写入原版职业行：'..ABILITY_NAMES[acat]..' '..count..' 项；正在重载本轮以让原版初始化生效'
  log(S.action)
  reloadRoom(S.room or 1)
end

local function shiftState()
  local _,p=player()
  if not valid(p)then log('SHIFT-STATE no player');return end
  log('ABILITY-STATE class='..tostring(p.CharacterKey.CharacterClass)..' perks='..#p.PerkDataComponent.PerkDataIds..' skills='..#p.SkillComponent.SkillActors..' spells='..#p.SpellComponent.SpellActors)
  local cap=NativeLoadout.capture(tonumber(p.CharacterKey.CharacterClass))
  if cap and cap.row then log('ABILITY-STATE row perk='..#cap.row.perk..' skill='..#cap.row.skill..' spell='..#cap.row.spell..' music='..#cap.row.music) end
  local asc=p.AbilitySystemComponent
  local items=asc.ActivatableAbilities.Items
  for i=1,#items do
    local spec=items[i];local ability=spec.Ability;local name=valid(ability)and ability:GetFullName()or''
    if name:find('ShapeShift',1,true)then
      log('SHIFT-STATE spec '..name..' activeCount='..tostring(spec.ActiveCount))
      for _,field in ipairs({'NonReplicatedInstances','ReplicatedInstances'})do
        local arr=spec[field]
        for j=1,#arr do
          local inst=arr[j];pcall(function()if inst.get then inst=inst:get()end end)
          if valid(inst)then
            local data=inst.CurrentShapeShiftDataAsset
            log('SHIFT-STATE inst '..name..' active='..tostring(inst.bIsActive)..' ending='..tostring(inst.bIsAbilityEnding)..' asset='..(valid(data)and data:GetFullName()or'nil'))
          end
        end
      end
    end
  end
  local c=p.ShapeShiftComponent
  log('SHIFT-STATE data='..(valid(c.Data)and c.Data:GetFullName()or'nil')..' applied='..(valid(c.AppliedData)and c.AppliedData:GetFullName()or'nil')..' specs='..#c.AbilitySpecHandles..' effects='..#c.GameplayEffectHandles)
  local mem=p.ClassShapeShiftComponent
  log('SHIFT-STATE memory='..#mem.ShapeShiftDatas)
  local life=S.druidLifecycle
  if life then log('SHIFT-STATE lifecycle started='..tostring(life.started)..' triggered='..tostring(life.triggered)..' applied='..tostring(life.applied)..' errors='..tostring(life.errors)..' stage='..tostring(life.lastStage)..' error='..tostring(life.lastError)..' context='..tostring(life.lastContextError)..' observe='..tostring(life.lastObservation))end
  S.action='shift state written';log(S.action)
end

local function command(raw)
  if Commands.simple(raw,S,startGui,Switch) then return end
  if raw:find("\n",1,true)then
    for line in raw:gmatch("[^\r\n]+")do
      local ok,e=pcall(command,line)
      if not ok then S.action=tostring(e);log(S.action)end
    end
    return
  end
  raw=raw:gsub('^%s+',''):gsub('%s+$','');log('command='..raw)
  local sp,spv=raw:match('^speed%s+(%a+)%s+([%d%.]+)$')
  if sp then
    local v=tonumber(spv);assert(v and v>0,'Speed must be a positive number')
    if sp=='player'then S.playerSpeed=v elseif sp=='monster'then S.monsterSpeed=v else error('speed player|monster <0.05-2>')end
    applySpeed(true);S.action='速度已设置：'..sp..'='..v;return
  end
  -- 面板一次只能写一条命令（命令队列），所以玩家+怪物合成一条。
  local pv,mv=raw:match('^speed%s+both%s+([%d%.]+)%s+([%d%.]+)$')
  if pv then
    local a,b=tonumber(pv),tonumber(mv);assert(a and b and a>0 and b>0,'Speed must be a positive number')
    S.playerSpeed=a;S.monsterSpeed=b;applySpeed(true);S.action='速度已设置：player='..a..' monster='..b;return
  end
  if raw=='speed' then S.action='当前速度：player='..tostring(S.playerSpeed or 1)..' monster='..tostring(S.monsterSpeed or 1);return end
  if raw=='guard'or raw=='guard on'or raw=='guard off'then
    local _,p=player();assert(p,'No dungeon player')
    local desired=raw=='guard on'or(raw=='guard'and not S.guard)
    if desired then S.guardState=Guard.enable(p,S.guardState)else S.guardState=Guard.disable(p,S.guardState)end
    S.guard=Guard.has(p);S.uiGuardActual=S.guard;assert(S.guard==desired,'Original immunity state did not match request')
    S.action='Original player immunity '..(S.guard and 'enabled' or 'disabled');return
  end
  if raw=='autoheal'or raw=='autoheal on'or raw=='autoheal off'then S.autoHeal=raw=='autoheal on'or(raw=='autoheal'and not S.autoHeal);S.nextAutoHeal=nil;S.action='Auto heal: '..tostring(S.autoHeal);return end
  if raw=='snapshot' then snapshot();return end
  local applyCat,applyGroup,applyIds=raw:match("^ability apply (%a+)#?(%d*)%s*(.*)$")
  if applyCat then abilityApply(applyCat,applyIds,tonumber(applyGroup));return end
  if raw=='ability-catalog' then abilityCatalog();return end
  if raw=='shift-state' then shiftState();return end
  if raw=='native-capture' then
    local choice=Classes.selected()
    local report=NativeLoadout.capture(choice)
    for _,key in ipairs({'perk','skill','spell','music'})do
      log('NATIVE-ROW '..key..'='..table.concat((report.row and report.row[key])or{},','))
      log('NATIVE-ACCOUNT '..key..'='..table.concat((report.account and report.account[key])or{},','))
    end
    S.action='Native class-row capture written to log';return
  end
  if raw=='recover-attack'then recoverAttack();return end
  if raw=='autorecover on'or raw=='autorecover off'then S.autoRecover=raw=='autorecover on';S.abilityRecoveryAutoTick=0;S.action='Auto attack recovery: '..tostring(S.autoRecover);return end
  if raw=='reset-character'then
    local _,p=player();assert(p,'No dungeon player')
    assert(S.characterResetBaseline and S.characterResetBaseline.address==p:GetAddress(),'Character reset baseline unavailable')
    local lib=StaticFindObject('/Script/GameplayAbilities.Default__AbilitySystemBlueprintLibrary')
    local getEffect=StaticFindObject('/Script/GameplayAbilities.AbilitySystemBlueprintLibrary:GetGameplayEffectFromActiveEffectHandle')
    local cancel=StaticFindObject('/Script/GameplayAbilities.GameplayAbility:K2_CancelAbility')
    local clear=StaticFindObject('/Script/DungeonCrawler.DCCharacterBase:RemoveAllLocalStateTags')
    local preserve={}
    if S.guardState then for _,h in ipairs(S.guardState.handles or{})do preserve[h.Handle]=true end end
    local result=CharacterReset.reset(p,S.characterResetBaseline,{
      valid=valid,name=function(o)return o and o:GetFullName()or''end,effect=function(h)return getEffect(lib,h)end,
      cancel=function(instance)return cancel(instance)end,preserveHandles=function()return preserve end,removeLocalState=function(target)return clear(target)end,
    })
    S.action=string.format('Character state reset: abilities=%d owned_effects=%d transient_effects=%d',result.abilities,result.ownedEffects,result.transientEffects)
    log(S.action)
    return
  end
  if raw:match('^ui%-reload%s+%d+$')then
    local v=raw:match('^ui%-reload%s+(%d+)$')
