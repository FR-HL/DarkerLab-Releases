  if esc and tab then
    local function showPanel()
      if PanelHotkeys.toggleFromMenuKey(S)~=nil then if S.panelVisible and startGui then pcall(startGui)end;publish()end
    end
    local okEsc,eEsc=pcall(RegisterKeyBind,esc,{},showPanel)
    local okTab,eTab=pcall(RegisterKeyBind,tab,{},showPanel)
    if okEsc and okTab then S.panelMenuKeysInstalled=true
    else log('Esc/Tab panel hotkey registration failed: Esc='..tostring(eEsc)..' Tab='..tostring(eTab))end
  else
    log('UE4SS Key.ESCAPE/TAB is unavailable; F9 panel hotkey remains active')
  end
end
if not S.shiftStateKeyInstalled then
  RegisterKeyBind(Key.F8,{},function()S.dispatch('shift-state')end)
  S.shiftStateKeyInstalled=true
  log('F8 registered for shape state diagnostics')
end
if not S.recoveryKeyInstalled then
  RegisterKeyBind(Key.F12,{},function()S.dispatch('recover-attack')end)
  S.recoveryKeyInstalled=true
  log('F12 registered for released stuck ability recovery; granted abilities are retained')
end
if S.controlTimer then Scheduler.cancel(S.controlTimer)end
S.controlTimer=Scheduler.loop(250,function()
  if S.generation~=generation then return true end
  if S.druidLifecycle then
    local okLife,lifeErr=pcall(S.druidLifecycle.tick,S.druidLifecycle)
    if not okLife then log('druid lifecycle tick: '..tostring(lifeErr)) end
    if S.druidLifecycle.lastStage and S.druidLifecycle.lastStage~=S.druidLifecycleStage then
      S.druidLifecycleStage=S.druidLifecycle.lastStage;log('druid lifecycle stage='..tostring(S.druidLifecycleStage))
    end
    if S.druidLifecycle.lastError and S.druidLifecycle.lastError~=S.druidLifecycleError then
      S.druidLifecycleError=S.druidLifecycle.lastError;log('druid lifecycle error: '..tostring(S.druidLifecycleError))
    end
    if S.druidLifecycle.lastContextError and S.druidLifecycle.lastContextError~=S.druidLifecycleContext then
      S.druidLifecycleContext=S.druidLifecycle.lastContextError;log('druid lifecycle context: '..tostring(S.druidLifecycleContext))
    end
    if S.druidLifecycle.lastObservation and S.druidLifecycle.lastObservation~=S.druidLifecycleObservation then
      S.druidLifecycleObservation=S.druidLifecycle.lastObservation;log('druid lifecycle observe: '..tostring(S.druidLifecycleObservation))
    end
  end
  local ok,e=pcall(tick);if not ok then S.sample=tostring(e)end
  local published,err=pcall(publish);if not published then log('state publish failed: '..tostring(err))end
  return false
end)
if S.autoHealTimer then Scheduler.cancel(S.autoHealTimer)end
S.autoHealTimer=Scheduler.loop(1000,function()
  if S.autoHeal then pcall(autoHeal)end
  return false
end)
if not S.autoArenaScheduled then
  S.autoArenaScheduled=true
  local attempts=0
  Scheduler.loop(1000,function()
    if S.hasPlayer then return true end
    if S.travelUntil or S.classSwitchPending then return false end
    local now=os.clock()
    if not S.autoArenaStart then S.autoArenaStart=now end
    if now-S.autoArenaStart<10 then return false end
    if S.autoArenaNext and now<S.autoArenaNext then return false end
    attempts=attempts+1
    if attempts>8 then log('auto arena gave up');return true end
    S.autoArenaNext=now+3
    local ok,e=pcall(S.dispatch,'room 1')
    log('auto arena attempt '..attempts..' ok='..tostring(ok)..' '..tostring(e))
    return false
  end)
end
publish()
