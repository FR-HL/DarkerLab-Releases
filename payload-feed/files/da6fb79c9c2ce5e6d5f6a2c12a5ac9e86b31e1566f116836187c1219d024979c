 elseif state.uiError then p.title,p.detail=U.friendlyError(state.uiError)
 elseif phase=='blocked'then p.title,p.detail=U.friendlyError(state.action)
 elseif attributePending then p.title='正在重载本轮';p.detail='重载后自动核对七项基础值。'
 elseif busy then
  local titles={loading_scene='正在准备场地',preparing_scene='正在准备原版运行环境',initializing='正在准备原版怪物'}
  p.title=titles[phase]or'正在准备训练';p.detail='请稍候，准备完成后会显示可训练状态。'
 elseif phase=='ready'or phase=='ready_with_warning'or(phase=='adopted'and board.current)then p.title='可以开始训练';p.detail='训练对象已准备好；具体机制仍以实测为准。'
 end
 if not busy and not state.uiError and phase~='blocked'then
  local raw=tostring(state.action or'')
  local confirmations={{'Saved original','当前职业配装已保存。'},{'Added to bag','已放入背包，请手动穿戴。'},{'Added to original bag','所选物品已添加到背包。'},{'Debug snapshot saved','诊断快照已保存。'},{'Heal:','生命已恢复。'},{'loadout restored','已把保存的配装放入背包。'},{'already matches','当前配装与保存记录一致。'}}
