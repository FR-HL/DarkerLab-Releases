 end
 if result and result.status=='ok'and result.title then p.title=result.title;p.detail=result.detail or'';if board.pending then p.detail=p.detail..' 训练仍在准备中。'end
 elseif result and result.status=='error'then p.title=result.title or'操作未完成';p.detail=result.detail or select(2,U.friendlyError(result.error))end
 p.canStart=state.hasPlayer==true and not busy and not state.deathFailure and not attributePending and state.gameInfoFallbackInstalled==true and (state.sceneMode~='room'or state.roomReady==true)
 p.canReset=p.canStart and board.current~=nil and board.current.record~=nil
 p.canClear=state.hasPlayer==true and(board.current~=nil or board.pending~=nil or #(board.retainedCorpses or{})>0)
 p.canResetPosition=state.hasPlayer==true and not busy and state.uiCanResetPosition==true
