  r.generation=generation;r.status='pending';return
 end
 if phase=='room_ready'then
  local r=state.uiResult
  if r and r.kind=='boss-room'then r.status='ok';r.title='Boss 房已载入';r.detail='房间内没有生成 Boss；选择怪物后逐只生成。' end
 end
 if phase=='ready'or phase=='ready_with_warning'or phase=='blocked'then
  local r=U.beginCommand(state,'switch');r.generation=generation;r.status=phase=='blocked'and'error'or'ok';r.error=phase=='blocked'and raw or nil
  r.title=phase=='blocked'and'训练未开始'or'训练对象已生成';r.detail=phase=='blocked'and select(2,U.friendlyError(raw))or'重置位置可让玩家与当前训练怪回到初始位置。'
