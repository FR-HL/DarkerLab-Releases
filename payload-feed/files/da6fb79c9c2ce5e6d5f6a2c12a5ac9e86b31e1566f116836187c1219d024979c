 for _,id in ipairs(ids)do
  local r=catalog.records[id];local native=U.data.monsters and U.data.monsters[id];local name=native and native.name or r.name;local _,kind=U.monsterType(r.class_type);local _,grade=U.grade(r.grade)
  local scene=r.modules and r.modules[1]and catalog.modules[r.modules[1]]
  local sceneName=scene and tostring(scene.name):gsub('（Text_.-）$','')or''
  out[#out+1]=table.concat({clean(id),clean(name),kind,grade,scene and'1'or'0',clean(sceneName),name~=id and'1'or'0'},'\t')
 end
